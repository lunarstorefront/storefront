{
    "name": "lunarstorefront/storefront",
    "require": {
        "php": "^8.4",
        "ext-intl": "*",
        "laravel/framework": "^11.0|^12.0|^13.0",
        "spatie/laravel-data": "^4.18",
        "spatie/laravel-typescript-transformer": "^2.5|^3.0",
        "lunarphp/core": "^2.0@dev",
        "lunarphp/search": "^2.0@dev",
        "inertiajs/inertia-laravel": "^3.0"
    },
    "license": "MIT",
    "autoload": {
        "files": [
            "src/helpers.php"
        ],
        "psr-4": {
            "Lunar\\Storefront\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Alec Ritson",
            "email": "alec@lunarphp.io"
        }
    ],
    "extra": {
        "laravel": {
            "providers": [
                "Lunar\\Storefront\\StorefrontServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "suggest": {
        "lunarphp/table-rate-shipping": "Required by storefront:install",
        "lunarphp/panel": "Required by storefront:install",
        "lunarphp/checkout": "Required by storefront:install",
        "lunarphp/lunar-cms": "Required by storefront:install",
        "neoncommerce/storefront-cache": "Required by storefront:install"
    },
    "scripts": {
        "test": "pest",
        "test-coverage": "pest --coverage"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "pestphp/pest-plugin": true
        }
    },
    "require-dev": {
        "laravel/boost": "^2.0",
        "orchestra/testbench": "^9.0|^10.0",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0",
        "larastan/larastan": "^3.9",
        "laravel/pint": "^1.29",
        "lunarphp/table-rate-shipping": "^2.0@alpha"
    },
    "autoload-dev": {
        "psr-4": {
            "Lunar\\Storefront\\Tests\\": "tests/"
        }
    }
}
