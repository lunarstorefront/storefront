{
    "name": "lunarstorefront/storefront",
    "require": {
        "php": "^8.2|^8.3|^8.4",
        "laravel/framework": "^11.0|^12.0|^13.0",
        "spatie/laravel-data": "^4.18",
        "spatie/laravel-typescript-transformer": "^2.5",
        "lunarphp/lunar": "^1.0",
        "lunarphp/search": "^1.2"
    },
    "license": "MIT",
    "autoload": {
        "files": [
          "src/helpers.php"
        ],
        "psr-4": {
            "Lunar\\Storefront\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Alec Ritson",
            "email": "alec@lunarphp.io"
        }
    ],
  "extra": {
    "laravel": {
      "providers": [
        "Lunar\\Storefront\\StorefrontServiceProvider"
      ]
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
    "scripts": {
        "test": "pest",
        "test-coverage": "pest --coverage"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "pestphp/pest-plugin": true
        }
    },
    "require-dev": {
        "laravel/boost": "^1.8",
        "orchestra/testbench": "^9.0|^10.0",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Lunar\\Storefront\\Tests\\": "tests/"
        }
    }
}
