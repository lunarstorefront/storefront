{
    "name": "lunarstorefront/storefront",

    "repositories": [
      {
        "type": "path",
        "url": "../../lunar/lunar-v2/packages/lunar"
      },
      {
        "type": "path",
        "url": "../../lunar/lunar-v2/packages/kernel"
      },
      {
        "type": "path",
        "url": "../../lunar/lunar-v2/packages/catalog"
      },
      {
        "type": "path",
        "url": "../../lunar/lunar-v2/packages/sales"
      },
      {
        "type": "path",
        "url": "../../lunar/lunar-v2/packages/promotions"
      },
      {
        "type": "path",
        "url": "../../lunar/lunar-v2/packages/search"
      },
      {
        "type": "path",
        "url": "../../lunar/lunar-v2/packages/panel"
      }
    ],
    "require": {
        "php": "^8.2|^8.3|^8.4",
        "laravel/framework": "^11.0|^12.0|^13.0",
        "spatie/laravel-data": "^4.18",
        "spatie/laravel-typescript-transformer": "^2.5",
        "lunarphp/panel": "dev-main as 2.0.0",
        "lunarphp/kernel": "dev-main as 2.0.0",
        "lunarphp/catalog": "dev-main as 2.0.0",
        "lunarphp/sales": "dev-main as 2.0.0",
        "lunarphp/promotions": "dev-main as 2.0.0",
        "lunarphp/lunar": "dev-main as 2.0.0",
        "lunarphp/search": "dev-main as 2.0.0"
    },
    "license": "MIT",
    "autoload": {
        "files": [
          "src/helpers.php"
        ],
        "psr-4": {
            "Lunar\\Storefront\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Alec Ritson",
            "email": "alec@lunarphp.io"
        }
    ],
  "extra": {
    "laravel": {
      "providers": [
        "Lunar\\Storefront\\StorefrontServiceProvider"
      ]
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
    "scripts": {
        "test": "pest",
        "test-coverage": "pest --coverage"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "pestphp/pest-plugin": true
        }
    },
    "require-dev": {
        "laravel/boost": "^1.8",
        "orchestra/testbench": "^9.0|^10.0",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0",
        "larastan/larastan": "^3.9",
        "laravel/pint": "^1.29"
    },
    "autoload-dev": {
        "psr-4": {
            "Lunar\\Storefront\\Tests\\": "tests/"
        }
    }
}
